{
  "path": ["backend/app", "frontend/src"],
  "format": ["python", "typescript", "tsx"],
  "ignore": [
    "**/node_modules/**",
    "**/components/ui/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/tests/**",
    "**/migrations/**"
