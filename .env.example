# Copie para .env (cp .env.example .env) e preencha. O .env nunca vai para o Git.

# OBRIGATÓRIO. Assina o cookie de sessão; sem ela o app não sobe.
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Permite criar contas em POST /api/auth/register (true/false). Padrão: true.
# Crie a sua conta e deixe false antes de publicar o app na internet.
ALLOW_REGISTRATION=true

# Sobrescreve o caminho do banco SQLite (opcional).
# Dev local: sqlite:////caminho/absoluto/para/data/app.db
# Docker: já vem pronto via docker-compose.yml, não precisa setar aqui.
# DATABASE_URL=
