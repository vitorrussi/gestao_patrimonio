# Copie para .env (cp .env.example .env) e preencha. O .env nunca vai para o Git.

# OBRIGATÓRIO. Assina o cookie de sessão; sem ela o app não sobe.
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Permite criar contas em POST /api/auth/register (true/false). Padrão: true.
# Crie a sua conta e deixe false antes de publicar o app na internet.
ALLOW_REGISTRATION=true

# Só para `make demo` (dados fictícios na porta 8081). Precisa ser DIFERENTE da SECRET_KEY:
# com a mesma chave, uma sessão do demo seria aceita no app real. Gere outra com o mesmo comando.
DEMO_SECRET_KEY=

# Sobrescreve o caminho do banco SQLite. Em geral NÃO use: o container lê este mesmo arquivo,
# e o `make dev` já usa um banco próprio em data/dev.
# DATABASE_URL=
